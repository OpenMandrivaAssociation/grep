+size_t
+perf_mmap_unmap_len (size_t file_len)
+{
+  long page = sysconf (_SC_PAGESIZE);
+  if (page <= 0)
+    page = 4096;
+  /* Cover file content plus one sentinel byte, rounded up to a page.  */
+  return (file_len + 1 + (size_t) page - 1) & ~((size_t) page - 1);
+}
+
 void *
 perf_try_mmap (int fd, off_t size, size_t *map_len)
 {
   if (size < GREP_MMAP_MIN || (uintmax_t) size > SIZE_MAX - 1)
     return nullptr;
 
-  /* Map enough for the file plus one sentinel byte (DFA writes EOL at
-     buffer end via *end = eol in dfaexec_main).  MAP_PRIVATE CoW keeps
-     the file read-only on disk.
-
-     Critical: when file_len is page-aligned, the +1 byte would land on
-     a page with no file backing and the kernel delivers SIGBUS.  Round
-     up to the next page so the sentinel always falls on a valid (zero-
-     filled beyond EOF) MAP_PRIVATE page.  */
+  /* DFA (dfaexec_main) and EGexecute (rawmemchr) need a writable sentinel
+     byte at offset file_len.  A pure file-backed mmap cannot provide that
+     when file_len is page-aligned: entire pages past EOF have no file
+     backing and the kernel delivers SIGBUS on first access — even with
+     MAP_PRIVATE.  (Zero-fill past EOF only applies within the last
+     partial page of the file.)
+
+     Fix: anonymous map for the full region (file + sentinel padding),
+     then overlay the file with MAP_FIXED over only the file-backed
+     extent.  The sentinel lands on remaining anonymous zeros.  */
   size_t file_len = (size_t) size;
   long page = sysconf (_SC_PAGESIZE);
-  size_t map_sz = (file_len + page) & ~((size_t) page - 1);
-  int flags = MAP_PRIVATE;
-#ifdef MAP_POPULATE
-  flags |= MAP_POPULATE;
-#endif
+  if (page <= 0)
+    page = 4096;
+  size_t map_sz = perf_mmap_unmap_len (file_len);
+  size_t file_backed = file_len == 0
+    ? 0
+    : (file_len + (size_t) page - 1) & ~((size_t) page - 1);
+
   int prot = PROT_READ | PROT_WRITE;
-  void *p = mmap (nullptr, map_sz, prot, flags, fd, 0);
+  void *p = mmap (nullptr, map_sz, prot,
+                  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
   if (p == MAP_FAILED)
+    return nullptr;
+
+  if (file_backed > 0)
     {
-      /* Retry without POPULATE (older kernels / exotic mounts).  */
-      p = mmap (nullptr, map_sz, prot, MAP_PRIVATE, fd, 0);
-      if (p == MAP_FAILED)
-        return nullptr;
+      int flags = MAP_PRIVATE | MAP_FIXED;
+#ifdef MAP_POPULATE
+      flags |= MAP_POPULATE;
+#endif
+      void *fm = mmap (p, file_backed, prot, flags, fd, 0);
+      if (fm == MAP_FAILED)
+        {
+          /* Retry without POPULATE (older kernels / exotic mounts).  */
+          fm = mmap (p, file_backed, prot, MAP_PRIVATE | MAP_FIXED, fd, 0);
+          if (fm == MAP_FAILED)
+            {
+              munmap (p, map_sz);
+              return nullptr;
+            }
+        }
     }
+
   /* Extra byte for DFA sentinel; not part of file content.  */
   ((char *) p)[file_len] = 0;
 
 #if defined MADV_SEQUENTIAL
-  madvise (p, file_len, MADV_SEQUENTIAL);
+  if (file_len)
+    madvise (p, file_len, MADV_SEQUENTIAL);
 #elif defined POSIX_MADV_SEQUENTIAL
-  posix_madvise (p, file_len, POSIX_MADV_SEQUENTIAL);
+  if (file_len)
+    posix_madvise (p, file_len, POSIX_MADV_SEQUENTIAL);
 #endif
 #if defined MADV_WILLNEED
-  madvise (p, file_len, MADV_WILLNEED);
+  if (file_len)
+    madvise (p, file_len, MADV_WILLNEED);
 #endif
 #if defined MADV_HUGEPAGE
-  madvise (p, file_len, MADV_HUGEPAGE);
+  if (file_len)
+    madvise (p, file_len, MADV_HUGEPAGE);
 #endif
 
   *map_len = file_len;
@@ -650,7 +684,15 @@
              const char *ndl, size_t nlen)
 {
 #if defined(__x86_64__) || defined(_M_X64)
-  return perf_memmem_avx2 (hay, hlen, ndl, nlen);
+  /* perf_memmem_avx2 is compiled with target("avx2").  Calling it on a
+     CPU without AVX2 raises SIGILL.  Dispatch at runtime so generic
+     x86_64 builds stay safe.  */
+  if (__builtin_cpu_supports ("avx2"))
+    return perf_memmem_avx2 (hay, hlen, ndl, nlen);
+  {
+    const void *r = memmem (hay, hlen, ndl, nlen);
+    return (const char *) r;
+  }
 #elif defined(__aarch64__) || defined(_M_ARM64)
   return perf_memmem_neon (hay, hlen, ndl, nlen);
 #elif defined(__loongarch_sx)
